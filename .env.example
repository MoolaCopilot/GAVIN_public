# GAVIN Environment Variables
# Copy this file to .env and fill in all values before running locally.
# On Railway, set these in the Variables tab of your project.

# ── Telegram ──────────────────────────────────────────────────────────────────
# Get from BotFather: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Generate a random secret string — used to verify webhook requests from Telegram.
# Example: python3 -c "import secrets; print(secrets.token_hex(32))"
TELEGRAM_WEBHOOK_SECRET=your_random_secret_here

# Your Telegram user ID(s) — only these can trigger the pipeline.
# Find yours by messaging @userinfobot on Telegram.
# Multiple users: comma-separated (e.g., 123456789,987654321)
ALLOWED_TELEGRAM_USER_IDS=your_telegram_user_id_here

# ── Anthropic / Claude ────────────────────────────────────────────────────────
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── ElevenLabs ────────────────────────────────────────────────────────────────
# Get from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# The voice ID to use for narration.
# Find voice IDs at: https://elevenlabs.io/app/voice-library
# Or via API: GET https://api.elevenlabs.io/v1/voices
ELEVENLABS_VOICE_ID=your_chosen_voice_id_here

# ── Transistor.fm (podcast publisher) ────────────────────────────────────────
# Sign up at transistor.fm, then:
#   API key: transistor.fm/app/account/api-key
#   Show ID: click your show → Settings → the numeric ID is in the URL
TRANSISTOR_API_KEY=your_transistor_api_key_here
TRANSISTOR_PODCAST_ID=your_transistor_show_id_here

# ── Server ────────────────────────────────────────────────────────────────────
# Railway sets PORT and RAILWAY_PUBLIC_DOMAIN automatically on deploy.
# Leave these as-is for local development.
PORT=8080
RAILWAY_PUBLIC_DOMAIN=
